#!/usr/bin/env bash
# Real git pre-commit hook, runs for every commit regardless of tool/editor
# (unlike .claude/hooks/, which only fire when Claude runs `git commit`).
# Install with: git config core.hooksPath .githooks
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
fail=0

if ! reason=$(scripts/check-staged-secrets.sh); then
  echo "pre-commit: BLOCKED — $reason" >&2
  fail=1
fi

if command -v go >/dev/null 2>&1; then
  staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' || true)

  if [[ -n "$staged_go_files" ]]; then
    unformatted=$(gofmt -l $staged_go_files 2>/dev/null || true)
    if [[ -n "$unformatted" ]]; then
      echo "pre-commit: BLOCKED — not gofmt-clean: $unformatted" >&2
      echo "pre-commit: run: gofmt -w $unformatted" >&2
      fail=1
    fi

    if command -v goimports >/dev/null 2>&1; then
      unimported=$(goimports -l $staged_go_files 2>/dev/null || true)
      if [[ -n "$unimported" ]]; then
        echo "pre-commit: BLOCKED — needs goimports: $unimported" >&2
        fail=1
      fi
    fi

    if ! go vet ./... 2>&1; then
      echo "pre-commit: BLOCKED — go vet failed" >&2
      fail=1
    fi

    # via with-env.sh, or the store integration tests skip and report green
    if ! scripts/with-env.sh go test ./... 2>&1; then
      echo "pre-commit: BLOCKED — go test failed" >&2
      fail=1
    fi
  fi
else
  echo "pre-commit: go not on PATH — skipping gofmt/vet/test" >&2
fi

if [[ "$fail" -ne 0 ]]; then
  echo "pre-commit: fix the issues above. Emergency bypass: git commit --no-verify." >&2
  exit 1
fi

echo "pre-commit: all checks passed."
exit 0
