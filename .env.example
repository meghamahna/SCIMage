# Copy this file to .env and fill in real values.
# .env is gitignored: never commit real credentials.
#
# docs/CONFIGURATION.md is the authoritative reference for every variable; the
# comments here are a quick guide. Keep the two in step when either changes.

POSTGRES_USER=scimage
POSTGRES_PASSWORD=changeme
POSTGRES_DB=scimage
POSTGRES_PORT=5432

# Full connection string used by the app and by `make migrate`.
DATABASE_URL=postgres://scimage:changeme@localhost:5432/scimage?sslmode=disable

# Pool ceiling and connection lifetime. Unset leaves pgx's own defaults (4
# conns, 1h lifetime) in place; set these to cap the pool at what your
# Postgres instance can actually take.
# DATABASE_MAX_CONNS=10
# DATABASE_MAX_CONN_LIFETIME=30m

# No bearer token to configure here: tenants and their tokens are issued
# through `scimage-admin` (see docs/CONFIGURATION.md#tenants-and-tokens),
# not set as an environment variable.

# Listen address for the server. Defaults to :8080.
# SCIM_ADDR=:8080

# Bounds one request's database work, including auth's token lookup, so a
# stuck query fails the request instead of holding a connection forever.
# Defaults to 10s; a non-positive value disables it.
# SCIM_REQUEST_TIMEOUT=10s

# Admin console (Phase 14). Opt-in: the console only starts when CONSOLE_ADDR is
# set, since it exposes a full-mutation admin surface. The recommended value
# binds loopback so it isn't reachable off-host without a deliberate tunnel;
# authenticate with a `scimage-admin console-token issue` credential.
# CONSOLE_ADDR=127.0.0.1:8090

# Cosmetic label shown in the console's sidebar badge (e.g. prod, staging).
# SCIMAGE_ENV=local

# Optional. Set when the server sits behind a proxy, so Location, meta.location
# and the URL `scimage-admin tenant create` prints use your external URL and
# scheme.
# SCIM_BASE_URL=https://scim.example.com

# Token bucket, in requests per second, keyed per caller. 0 disables limiting.
# SCIM_RATE_LIMIT=20
# SCIM_RATE_BURST=40

# Logs are structured JSON on stdout and in a dated file under LOG_DIR.
# Set LOG_DIR empty in a container, where the runtime collects stdout.
# LOG_DIR=logs
# LOG_LEVEL=info

# Records request bodies, which contain user attributes. Useful when working
# out what an identity provider actually sends.
# SCIM_LOG_REQUESTS=1

# Extensible attributes. Set to 1 to let the server capture and
# return the extra attribute names a tenant registers with
# `scimage-admin attribute register`: known SCIM attributes this server
# doesn't model as typed columns, or fully custom fields. Off by default:
# unregistered attributes are dropped exactly as before.
# SCIM_EXTENDED_ATTRIBUTES=1

# Change delivery. Unset SCIM_WEBHOOK_URL disables it, and the store stops
# queueing events: nothing accumulates when no dispatcher is draining.
# A URL with no secret is a startup error, not an unsigned send.
# Generate the secret with: openssl rand -hex 32
# SCIM_WEBHOOK_URL=https://app.example.com/scim-events
# SCIM_WEBHOOK_SECRET=<secret>

# Allows a plaintext endpoint. Local receivers only: events carry user
# attributes, and the signature protects authenticity, not confidentiality.
# SCIM_WEBHOOK_ALLOW_HTTP=1

# Attempts before a delivery is parked in the dead-letter queue.
# SCIM_WEBHOOK_MAX_ATTEMPTS=6

# How long delivered rows are kept before the dispatcher prunes them, in days.
# Only delivered rows are swept: pending ones are in flight and dead-lettered
# ones are kept for a human to replay. Defaults to 30; set 0 to keep forever.
# SCIM_WEBHOOK_RETENTION_DAYS=30

# ARIA, the audit-review advisor (`cmd/aria`). It computes activity signals in
# Go and asks an LLM to narrate them, staying advisory: the code routes its
# output only to the human reviewer. It works with any OpenAI-compatible
# chat-completions API (Anthropic's compat endpoint, OpenAI, OpenRouter, a
# local Ollama or vLLM). Read only when a window has findings, so a quiet review
# runs without a key. The console's ARIA page narrates on demand too, so set
# these in the server's environment if you want its "Generate briefing" button.
# ARIA_LLM_BASE_URL=https://api.anthropic.com/v1
# ARIA_LLM_API_KEY=<your provider key>
# ARIA_LLM_MODEL=claude-sonnet-4-5
# Optional. IANA timezone for the off-hours check; defaults to the host's zone.
# ARIA_TIMEZONE=America/Vancouver
