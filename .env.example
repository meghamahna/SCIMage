# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

POSTGRES_USER=scimage
POSTGRES_PASSWORD=changeme
POSTGRES_DB=scimage
POSTGRES_PORT=5432

# Full connection string used by the app and by `make migrate`.
DATABASE_URL=postgres://scimage:changeme@localhost:5432/scimage?sslmode=disable

# Bearer token every SCIM request must present. No default on purpose: the
# server refuses to start without one, rather than coming up unauthenticated.
# Generate with: openssl rand -hex 32
SCIM_TOKEN=<token>

# Optional. Set when the server sits behind a proxy, so Location and
# meta.location don't come from the client-controlled Host header.
# SCIM_BASE_URL=https://scim.example.com
