# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

POSTGRES_USER=scimage
POSTGRES_PASSWORD=changeme
POSTGRES_DB=scimage
POSTGRES_PORT=5432

# Full connection string used by the app and by `make migrate`.
DATABASE_URL=postgres://scimage:changeme@localhost:5432/scimage?sslmode=disable

# No bearer token to configure here — tenants and their tokens are issued
# through `scimage-admin` (see docs/CONFIGURATION.md#tenants-and-tokens),
# not set as an environment variable.

# Listen address for the server. Defaults to :8080.
# SCIM_ADDR=:8080

# Optional. Set when the server sits behind a proxy, so Location, meta.location
# and the URL `scimage-admin tenant create` prints use your external URL and
# scheme.
# SCIM_BASE_URL=https://scim.example.com

# Token bucket, in requests per second, keyed per caller. 0 disables limiting.
# SCIM_RATE_LIMIT=20
# SCIM_RATE_BURST=40

# Logs are structured JSON on stdout and in a dated file under LOG_DIR.
# Set LOG_DIR empty in a container, where the runtime collects stdout.
# LOG_DIR=logs
# LOG_LEVEL=info

# Records request bodies, which contain user attributes. Useful when working
# out what an identity provider actually sends.
# SCIM_LOG_REQUESTS=1

# Extensible attributes (Phase 14). Set to 1 to let the server capture and
# return the extra attribute names a tenant registers with
# `scimage-admin attribute register` — known SCIM attributes this server
# doesn't model as typed columns, or fully custom fields. Off by default:
# unregistered attributes are dropped exactly as before.
# SCIM_EXTENDED_ATTRIBUTES=1

# Change delivery. Unset SCIM_WEBHOOK_URL disables it, and the store stops
# queueing events — nothing accumulates when no dispatcher is draining.
# A URL with no secret is a startup error, not an unsigned send.
# Generate the secret with: openssl rand -hex 32
# SCIM_WEBHOOK_URL=https://app.example.com/scim-events
# SCIM_WEBHOOK_SECRET=<secret>

# Allows a plaintext endpoint. Local receivers only — events carry user
# attributes, and the signature protects authenticity, not confidentiality.
# SCIM_WEBHOOK_ALLOW_HTTP=1

# Attempts before a delivery is parked in the dead-letter queue.
# SCIM_WEBHOOK_MAX_ATTEMPTS=6
