# Copy this file to .env and fill in real values. .env is gitignored: never
# commit real credentials. docs/CONFIGURATION.md is the authoritative
# reference for every variable; keep it in step with this file.

# ---- Database ----
POSTGRES_USER=scimage
POSTGRES_PASSWORD=changeme
POSTGRES_DB=scimage
POSTGRES_PORT=5432

# Connection string the app and `make migrate` use. Keep in sync with the
# POSTGRES_* values above.
DATABASE_URL=postgres://scimage:changeme@localhost:5432/scimage?sslmode=disable

# Pool ceiling and connection lifetime. Unset uses pgx's defaults (4 conns, 1h).
# DATABASE_MAX_CONNS=10
# DATABASE_MAX_CONN_LIFETIME=30m

# ---- Server ----
# SCIM_ADDR=:8080

# Bounds one request's database work, including auth's token lookup, so a
# stuck query fails the request instead of holding a connection forever.
# Defaults to 10s; a non-positive value disables it.
# SCIM_REQUEST_TIMEOUT=10s

# Set when the server sits behind a proxy, so Location, meta.location, and
# the URLs scimage-admin prints use your external host and scheme.
# SCIM_BASE_URL=https://scim.example.com

# Tenant SCIM tokens aren't set here: they're issued via `scimage-admin`
# (docs/CONFIGURATION.md#tenants-and-tokens).

# ---- Admin console (optional web UI) ----
# Opt-in: the console only starts when CONSOLE_ADDR is set, since it exposes
# a full-mutation admin surface. Loopback by default, so it isn't reachable
# off-host without a deliberate tunnel. Authenticate with a
# `scimage-admin console-token issue` credential.
# CONSOLE_ADDR=127.0.0.1:8090

# Cosmetic label shown in the console's sidebar badge (e.g. prod, staging).
# SCIMAGE_ENV=local

# ---- Rate limiting ----
# Token bucket, in requests per second, keyed per caller. 0 disables it.
# SCIM_RATE_LIMIT=20
# SCIM_RATE_BURST=40

# ---- Logging ----
# Structured JSON on stdout and in a dated file under LOG_DIR. Set LOG_DIR
# empty in a container, where the runtime collects stdout instead.
# LOG_DIR=logs
# LOG_LEVEL=info

# Also logs request bodies, which contain user attributes. Useful for seeing
# what an identity provider actually sends.
# SCIM_LOG_REQUESTS=1

# ---- Extensible attributes ----
# Captures and returns the extra attribute names a tenant registers with
# `scimage-admin attribute register`, instead of dropping them. Off by default.
# SCIM_EXTENDED_ATTRIBUTES=1

# ---- Webhooks (change delivery) ----
# Unset disables delivery, and the store stops queueing events. A URL with
# no secret is a startup error, not an unsigned send.
# Generate the secret with: openssl rand -hex 32
# SCIM_WEBHOOK_URL=https://app.example.com/scim-events
# SCIM_WEBHOOK_SECRET=<secret>

# Allows a plaintext endpoint. Local receivers only: the signature protects
# authenticity, not confidentiality.
# SCIM_WEBHOOK_ALLOW_HTTP=1

# Attempts before a delivery is parked in the dead-letter queue.
# SCIM_WEBHOOK_MAX_ATTEMPTS=6

# Days a delivered row is kept before being pruned. Dead-lettered rows are
# always kept for a human to replay. Defaults to 30; 0 keeps forever.
# SCIM_WEBHOOK_RETENTION_DAYS=30

# ---- ARIA (audit review: cmd/aria and the console's ARIA page) ----
# Works with any OpenAI-compatible chat-completions API: Anthropic's compat
# endpoint, OpenAI, OpenRouter, a local Ollama or vLLM. Set all three to
# enable the CLI's briefing and the console's ARIA nav entry.
# ARIA_LLM_BASE_URL=https://api.anthropic.com/v1
# ARIA_LLM_API_KEY=<your provider key>
# ARIA_LLM_MODEL=claude-sonnet-4-5

# IANA timezone for the off-hours check. Defaults to the host's local zone.
# ARIA_TIMEZONE=America/Vancouver
